// Gitignored local overlay, merged over wrangler.jsonc by `pnpm dev:api`.
// Generated by `pnpm setup:local` — see scripts/setup-local.sh.
//
// `main` and the compatibility fields MUST be repeated here: wrangler's
// multi-config merge does not inherit them from the base file, and their
// absence fails with a confusing "Missing entry-point to Worker script".
{
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-hyperdrive",
      "localConnectionString": "postgresql://user:pass@host/neondb?sslmode=require"
    }
  ]
}
