{
  // The marketing site and the public /trace/$code QR page, server-rendered.
  "name": "roastery-web-production",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "dist/client" },
  // API_URL is read at RUNTIME by the trace server function, so it is not a
  // VITE_ value baked into the client and verify-build-env.mjs cannot see it.
  // wrangler-vars.test.ts asserts every config carries the origin matching its
  // environment, because without one the QR page fetches localhost.
  "vars": { "API_URL": "https://api.roastery.run" },
  "routes": [{ "pattern": "roastery.run", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true
}
