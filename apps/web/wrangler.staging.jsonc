{
  // The marketing site and the public /trace/$code QR page, server-rendered.
  "name": "roastery-web-staging",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "dist/client" },
  "vars": { "API_URL": "https://api-staging.roastery.run" },
  "routes": [{ "pattern": "staging.roastery.run", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
