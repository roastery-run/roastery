link-workspace-packages=true
# Refuse to install on a Node that cannot run the build.
#
# `packages/db/scripts/generate-authz-migration.mjs` imports a TypeScript
# module directly, which relies on Node's type stripping — on by default from
# 22.18. Without this the mismatch surfaces as a migration that fails partway
# through a deploy rather than as an install that refuses up front.
engine-strict=true
