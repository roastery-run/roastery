{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".wrangler/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "cache": false },
    "test": { "dependsOn": ["^build"], "env": ["TEST_DATABASE_URL", "CI"] },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
