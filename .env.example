# Neon. Migrations and drizzle-kit connect directly; the Worker reaches it via
# Hyperdrive and never sees this string.
#
# Local dev uses Neon Local (docker compose): `pnpm db:up` proxies an ephemeral
# branch at localhost:5432, then `pnpm db:migrate`.
DATABASE_URL=postgresql://neon:npg@localhost:5432/neondb

# Neon Local — spawns and deletes ephemeral branches.
# API key: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=

# Better Auth — baseURL must match where /api/auth/* is served.
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8787

# OAuth. Redirect URI: http://localhost:8787/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SPA origins
VITE_API_URL=http://localhost:8787
